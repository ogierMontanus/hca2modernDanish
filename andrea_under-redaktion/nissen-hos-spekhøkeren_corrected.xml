<cell type="page" role="data" rows="1" cols="1">67</cell><row xml:id="txtcmnt-067-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Spekhøker(en)</cell><cell type="data-definition" role="data" rows="1" cols="1">detailforhandler af viktualier, smør, æg, brød og andre dagligvarer.</cell></row><row xml:id="txtcmnt-067-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Juleaften … Smør i</cell><cell type="data-definition" role="data" rows="1" cols="1">ifølge folketroen beskytter nissen hus og hjem, og som bekræftelse på det gode forhold sattes risengrød frem til nissen juleaften.</cell></row><row xml:id="txtcmnt-067-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Bøtte</cell><cell type="data-definition" role="data" rows="1" cols="1">skraldebøtte.</cell></row><row xml:id="txtcmnt-067-04" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Mundlæder</cell><cell type="data-definition" role="data" rows="1" cols="1">snakketøj.</cell></row>
