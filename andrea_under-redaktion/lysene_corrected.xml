<cell type="page" role="data" rows="1" cols="1">273</cell><row xml:id="txtcmnt-273-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Tællelys(et)</cell><cell type="data-definition" role="data" rows="1" cols="1">lys af talg; billigere og dårligere end vokslys.</cell></row><row xml:id="txtcmnt-273-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Spiddelys</cell><cell type="data-definition" role="data" rows="1" cols="1">tællelys, der er støbt, ved at en væge, anbragt på et lysespid, gentagne gange dyppes i flydende tælle.</cell></row><row xml:id="txtcmnt-273-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Praas</cell><cell type="data-definition" role="data" rows="1" cols="1">langt, tyndt tællelys.</cell></row>
<cell type="page" role="data" rows="1" cols="1">274</cell><row xml:id="txtcmnt-274-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Og det nøs derpå</cell><cell type="data-definition" role="data" rows="1" cols="1">ifølge folketroen er nyset et godt varsel, <pb n="450"/>tegn på, at en udtalelse er rigtig e.l.</cell></row><row xml:id="txtcmnt-274-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Du gode Gud … Amen</cell><cell type="data-definition" role="data" rows="1" cols="1">gammel bordbøn.</cell></row>
