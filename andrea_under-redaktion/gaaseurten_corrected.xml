<p rend="noIndent" part="N">Trykt første gang i Eventyr, fortalte for Børn. Ny Samling. Første Hefte, som udkom den 2. oktober 1838.<br/>
BFN 326/I,117-120/VII,42-43.</p>

<table rend="textcomments">
<cell type="page" role="data" rows="1" cols="1">184</cell><row xml:id="txtcmnt-184-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Gåseurt(en)</cell><cell type="data-definition" role="data" rows="1" cols="1">tusindfryd, bellis.</cell></row><row xml:id="txtcmnt-184-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Lyststed</cell><cell type="data-definition" role="data" rows="1" cols="1">sommervilla. Velhavende borgere fik opført sommerboliger uden for København, blandt andet fordi den trange bys åbne, sundhedsfarlige kloakker udbredte en ulidelig stank, ikke mindst i varme somre.</cell></row><row xml:id="txtcmnt-184-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Grøften</cell><cell type="data-definition" role="data" rows="1" cols="1">diget, jordvolden.</cell></row><row xml:id="txtcmnt-184-04" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">begavet</cell><cell type="data-definition" role="data" rows="1" cols="1">begunstiget, overøst med gaver.</cell></row><row xml:id="txtcmnt-184-05" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Pionerne</cell><cell type="data-definition" role="data" rows="1" cols="1">pæonerne, bonderoserne.</cell></row>
<cell type="page" role="data" rows="1" cols="1">185</cell><row xml:id="txtcmnt-185-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">vederfaret</cell><cell type="data-definition" role="data" rows="1" cols="1">hændt, overgået.</cell></row><row xml:id="txtcmnt-185-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Tiltale</cell><cell type="data-definition" role="data" rows="1" cols="1">irettesættelse, formaning.</cell></row><row xml:id="txtcmnt-185-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">så og kendte</cell><cell type="data-definition" role="data" rows="1" cols="1">så og genkendte.</cell></row>
