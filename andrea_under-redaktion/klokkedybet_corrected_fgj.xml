<row role="data" rows="1" cols="1"><cell type="position" role="data" rows="1" cols="1">239</cell><cell type="deviation" role="data" rows="1" cols="1">32: derfor &lt; det</cell></row>
<row role="data" rows="1" cols="1"><cell type="position" role="data" rows="1" cols="1">241</cell><cell type="deviation" role="data" rows="1" cols="1">13: og Aar &lt; Aar – Under teksten: H. C. Andersen</cell></row>
