<cell type="page" role="data" rows="1" cols="1">115</cell><row xml:id="txtcmnt-115-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">beslaaet</cell><cell type="data-definition" role="data" rows="1" cols="1">ordspil på betydningen: velhavende.</cell></row><row xml:id="txtcmnt-115-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Spyttebakken</cell><cell type="data-definition" role="data" rows="1" cols="1">beholder med sand eller desinficerende væske til at spytte i.</cell></row><row xml:id="txtcmnt-115-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">åben Begravelse</cell><cell type="data-definition" role="data" rows="1" cols="1">gravkapel, hvor kisterne står fremme.</cell></row><row xml:id="txtcmnt-115-04" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">når kom det</cell><cell type="data-definition" role="data" rows="1" cols="1">hvornår kom det.</cell></row><row xml:id="txtcmnt-115-05" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Bøtten</cell><cell type="data-definition" role="data" rows="1" cols="1">skraldebøtten.</cell></row>
