<table rend="textcomments">
<cell type="page" role="data" rows="1" cols="1">72</cell><row xml:id="txtcmnt-072-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Tælleprås</cell><cell type="data-definition" role="data" rows="1" cols="1">tyndt tællelys, lys af talg.</cell></row><row xml:id="txtcmnt-072-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Hollænder af Fødsel</cell><cell type="data-definition" role="data" rows="1" cols="1">den hollandske vindmølle er især karakteriseret ved jalousier på møllevingerne i stedet for møllesegl samt en drej<pb n="416"/>bar hat (top) med en vindroset, der altid holder vingerne i vindretningen.</cell></row><row xml:id="txtcmnt-072-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Skabelon</cell><cell type="data-definition" role="data" rows="1" cols="1">figur, fysisk fremtrædelsesform.</cell></row><row xml:id="txtcmnt-072-04" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">en flyvende Hollænder</cell><cell type="data-definition" role="data" rows="1" cols="1">ifølge folketroen et spøgelsesskib, der varsler forlis.</cell></row><row xml:id="txtcmnt-072-05" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">huse</cell><cell type="data-definition" role="data" rows="1" cols="1">bor, holder til.</cell></row><row xml:id="txtcmnt-072-06" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">avet om</cell><cell type="data-definition" role="data" rows="1" cols="1">bagvendt, venstre om.</cell></row><row xml:id="txtcmnt-072-07" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Styr</cell><cell type="data-definition" role="data" rows="1" cols="1">postyr.</cell></row><row xml:id="txtcmnt-072-08" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">fornummet</cell><cell type="data-definition" role="data" rows="1" cols="1">fornemmet.</cell></row>
<cell type="page" role="data" rows="1" cols="1">73</cell><row xml:id="txtcmnt-073-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">fordunstet</cell><cell type="data-definition" role="data" rows="1" cols="1">fordampet, forsvundet.</cell></row>
