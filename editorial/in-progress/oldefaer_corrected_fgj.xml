<table rend="textcomments">
<cell type="page" role="data" rows="1" cols="1">264</cell><row xml:id="txtcmnt-264-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Heidukker</cell><cell type="data-definition" role="data" rows="1" cols="1">lakajer.</cell></row><row xml:id="txtcmnt-264-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Laugene flytte Skilt</cell><cell type="data-definition" role="data" rows="1" cols="1">når lavene skiftede mødested, lavshus, førte de deres skilt, der forestillede det pågældende håndværks vigtigste værktøj, i festligt optog til det nye mødelokale.</cell></row><row xml:id="txtcmnt-264-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Julestue(r)</cell><cell type="data-definition" role="data" rows="1" cols="1">selskabelig sammenkomst (gilde) med julelege, dans o.l.</cell></row><row xml:id="txtcmnt-264-04" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Stejler, Hjul</cell><cell type="data-definition" role="data" rows="1" cols="1">stejlen er en opretstående pæl med et hjul hvilende vandret på toppen. Her anbragtes den radbrækkede eller henrettede; jf. udtrykket at blive lagt på hjul og stejle.</cell></row><row xml:id="txtcmnt-264-05" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Adelsmænd, der gav Bonden fri</cell><cell type="data-definition" role="data" rows="1" cols="1">Andreas Peter Bernstorff (1735-1797) og Chr. Ditlev Reventlow (1748-1827) var mændene bag stavnsbåndets ophævelse i 1788. Stavnsbåndet, der blev indført i 1733, bandt mænd i alderen 4 til 40 år til det gods, gården tilhørte.</cell></row><row xml:id="txtcmnt-264-06" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Kronprins, der ophævede Slavehandelen</cell><cell type="data-definition" role="data" rows="1" cols="1">kronprins Frederik (4.) (1768-1839) udstedte i 1792 Forordning om Neger-Handelen, som dog kun var et forbud mod indførsel af negre, ikke mod handel med negre på De Vestindiske Øer.</cell></row><row xml:id="txtcmnt-264-07" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">skikkede</cell><cell type="data-definition" role="data" rows="1" cols="1">passede.</cell></row><row xml:id="txtcmnt-264-08" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">flink</cell><cell type="data-definition" role="data" rows="1" cols="1">dygtig.</cell></row>
<cell type="page" role="data" rows="1" cols="1">265</cell><row xml:id="txtcmnt-265-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">disputere</cell><cell type="data-definition" role="data" rows="1" cols="1">diskutere.</cell></row><row xml:id="txtcmnt-265-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">imellem</cell><cell type="data-definition" role="data" rows="1" cols="1">indimellem.</cell></row><row xml:id="txtcmnt-265-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Aareladning</cell><cell type="data-definition" role="data" rows="1" cols="1">aftapning af blod var et almindeligt lægemiddel.</cell></row><row xml:id="txtcmnt-265-04" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">løber <pb n="449"/>man paa</cell><cell type="data-definition" role="data" rows="1" cols="1">kommer man i konflikt med hinanden.</cell></row>
<cell type="page" role="data" rows="1" cols="1">266</cell><row xml:id="txtcmnt-266-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">det Rare</cell><cell type="data-definition" role="data" rows="1" cols="1">det særlige.</cell></row><row xml:id="txtcmnt-266-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">bryde</cell><cell type="data-definition" role="data" rows="1" cols="1">brække over.</cell></row><row xml:id="txtcmnt-266-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">virke</cell><cell type="data-definition" role="data" rows="1" cols="1">udøve sit virke, sættes i søen.</cell></row>
