<table rend="textcomments">
<cell type="page" role="data" rows="1" cols="1">276</cell><row xml:id="txtcmnt-276-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Foderal</cell><cell type="data-definition" role="data" rows="1" cols="1">hylster.</cell></row><row xml:id="txtcmnt-276-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">uden og inden</cell><cell type="data-definition" role="data" rows="1" cols="1">udenpå og indeni.</cell></row><row xml:id="txtcmnt-276-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Moses … Gud</cell><cell type="data-definition" role="data" rows="1" cols="1">jf. 2. Mosebog 19-20.</cell></row><row xml:id="txtcmnt-276-04" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">de hellige tre Konger</cell><cell type="data-definition" role="data" rows="1" cols="1">de tre vise mænd fra Østerland, som ifølge evangelierne tilbeder det nyfødte jesusbarn. Den ene af dem afbildes i den maleriske tradition som sort.</cell></row><row xml:id="txtcmnt-276-05" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Kukkeren</cell><cell type="data-definition" role="data" rows="1" cols="1">gøgen.</cell></row>
<cell type="page" role="data" rows="1" cols="1">277</cell><row xml:id="txtcmnt-277-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">de syv Dødssynder</cell><cell type="data-definition" role="data" rows="1" cols="1">de synder, som ikke kan tilgives, og som derfor fører til den evige død. Den skolastiske tradition opregner følgende syv: hovmod, griskhed, vellevned, misundelse, frådseri (herunder drukkenskab), vrede og dovenskab.</cell></row><row xml:id="txtcmnt-277-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Ottesang</cell><cell type="data-definition" role="data" rows="1" cols="1">gudstjeneste før daggry kl. 3 (matutina) i den katolske kirke.</cell></row><row xml:id="txtcmnt-277-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">de ni Muser</cell><cell type="data-definition" role="data" rows="1" cols="1">i græsk mytologi skytsgudinder for kunst og videnskab, døtre af Zeus og Mnemosyne.</cell></row><row xml:id="txtcmnt-277-04" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">en … Astronomien</cell><cell type="data-definition" role="data" rows="1" cols="1">Urania.</cell></row><row xml:id="txtcmnt-277-05" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Een … Archiv</cell><cell type="data-definition" role="data" rows="1" cols="1">Klejo (historieskrivningens muse).</cell></row><row xml:id="txtcmnt-277-06" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Resten … Theatret</cell><cell type="data-definition" role="data" rows="1" cols="1">Melpomene (tragedien), Thaleja (komedien), Terpsikore (dansen, lyren), Erato (elskovsdigtningen), Kalliope (den episke digtning), Euterpe (sangen til fløjteledsagelse), Polyhymnia (hymnedigtningen). </cell></row><row xml:id="txtcmnt-277-07" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Bro, bro, brille … <hi rend="italic">elleve</hi></cell><cell type="data-definition" role="data" rows="1" cols="1">gammel børneleg; jf. S. Tvermose Thyregod Danmarks Sanglege, 1931, s. 220 ff.</cell></row><row xml:id="txtcmnt-277-08" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Kabuds</cell><cell type="data-definition" role="data" rows="1" cols="1">hue med øreklapper eller slag, der kan knappes foran munden eller smøges ned over nakken.</cell></row><row xml:id="txtcmnt-277-09" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Morgenstjerne</cell><cell type="data-definition" role="data" rows="1" cols="1">våben bestående af et skaft med en kugle besat med pigge.</cell></row><row xml:id="txtcmnt-277-10" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">poliske</cell><cell type="data-definition" role="data" rows="1" cols="1">snedige, snu.</cell></row>
