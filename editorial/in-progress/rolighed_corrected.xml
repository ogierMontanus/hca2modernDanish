                                   <div type="work" rend="»Rolighed«" xml:id="rolighed" part="N" org="uniform" sample="complete">
<head type="main">»Rolighed«</head>



Det gamle K<?oxy_delete author="as" timestamp="20231113T085335+0100" content="j"?>øbenhavn gror over <?oxy_comment_start author="as" timestamp="20231113T085808+0100" comment="Med stort eller småt, er meget i tvivl."?><?oxy_delete author="as" timestamp="20231113T085750+0100" content="V"?><?oxy_insert_start author="as" timestamp="20231113T085750+0100"?>v<?oxy_insert_end?>olden<?oxy_comment_end?>,
<?oxy_delete author="as" timestamp="20231113T085746+0100" content="D"?><?oxy_insert_start author="as" timestamp="20231113T085746+0100"?>d<?oxy_insert_end?>et knejser ungt ud mod de åbne <?oxy_delete author="as" timestamp="20231113T085741+0100" content="S"?><?oxy_insert_start author="as" timestamp="20231113T085741+0100"?>s<?oxy_insert_end?>øer,
<?oxy_delete author="as" timestamp="20231113T085844+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T085843+0100"?>h<?oxy_insert_end?>vor »Rosenvænget« når til Øresund,
<?oxy_delete author="as" timestamp="20231113T090023+0100" content="O"?><?oxy_insert_start author="as" timestamp="20231113T090023+0100"?>o<?oxy_insert_end?>g <?oxy_delete author="as" timestamp="20231113T085406+0100" content="Ko"?><?oxy_insert_start author="as" timestamp="20231113T085404+0100"?>ku<?oxy_insert_end?>nstner<?oxy_delete author="as" timestamp="20231113T085401+0100" content="-N"?><?oxy_insert_start author="as" timestamp="20231113T085401+0100"?>n<?oxy_insert_end?>avne lyse<?oxy_insert_start author="as" timestamp="20231113T085408+0100"?>r<?oxy_insert_end?> ud i <?oxy_delete author="as" timestamp="20231113T090027+0100" content="V"?><?oxy_insert_start author="as" timestamp="20231113T090026+0100"?>v<?oxy_insert_end?>erden.



Her trives <?oxy_delete author="as" timestamp="20231113T090029+0100" content="R"?><?oxy_insert_start author="as" timestamp="20231113T090029+0100"?>r<?oxy_insert_end?>oserne. Det vilde <?oxy_delete author="as" timestamp="20231113T090034+0100" content="V"?><?oxy_insert_start author="as" timestamp="20231113T090034+0100"?>v<?oxy_insert_end?>inløv
<?oxy_delete author="as" timestamp="20231113T090038+0100" content="U"?><?oxy_insert_start author="as" timestamp="20231113T090037+0100"?>u<?oxy_insert_end?>dfolder <?oxy_delete author="as" timestamp="20231113T090041+0100" content="E"?><?oxy_insert_start author="as" timestamp="20231113T090040+0100"?>e<?oxy_insert_end?>fterårets <?oxy_delete author="as" timestamp="20231113T090043+0100" content="F"?><?oxy_insert_start author="as" timestamp="20231113T090043+0100"?>f<?oxy_insert_end?>arvepragt,
<?oxy_delete author="as" timestamp="20231113T090113+0100" content="M"?><?oxy_insert_start author="as" timestamp="20231113T090113+0100"?>m<?oxy_insert_end?>ens bag <?oxy_delete author="as" timestamp="20231113T090053+0100" content="K"?><?oxy_insert_start author="as" timestamp="20231113T090053+0100"?>k<?oxy_insert_end?>astan<?oxy_delete author="as" timestamp="20231113T090116+0100" content="i"?><?oxy_insert_start author="as" timestamp="20231113T090116+0100"?>j<?oxy_insert_end?>etræer og <?oxy_delete author="as" timestamp="20231113T090056+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T090055+0100"?>h<?oxy_insert_end?>yld og <?oxy_delete author="as" timestamp="20231113T090058+0100" content="P"?><?oxy_insert_start author="as" timestamp="20231113T090057+0100"?>p<?oxy_insert_end?>opler
<?oxy_delete author="as" timestamp="20231113T090122+0100" content="E"?><?oxy_insert_start author="as" timestamp="20231113T090122+0100"?>e<?oxy_insert_end?>t <?oxy_delete author="as" timestamp="20231113T090051+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T090051+0100"?>h<?oxy_insert_end?>jem sig løfter, minderigt fra fortid.
Her sangen lød: »Eleonora Ulfeldt«,
<?oxy_delete author="as" timestamp="20231113T090136+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T090136+0100"?>h<?oxy_insert_end?>er tænkeren sad under poppelpilen
<?oxy_delete author="as" timestamp="20231113T090149+0100" content="O"?><?oxy_insert_start author="as" timestamp="20231113T090149+0100"?>o<?oxy_insert_end?>g lyttede til <?oxy_delete author="as" timestamp="20231113T085647+0100" content="Aa"?><?oxy_insert_start author="as" timestamp="20231113T085646+0100"?>å<?oxy_insert_end?>nden i naturen.


Det hjem er nu et lille »Rosenborg«,
<?oxy_delete author="as" timestamp="20231113T091424+0100" content="M"?><?oxy_insert_start author="as" timestamp="20231113T091424+0100"?>m<?oxy_insert_end?>ed tårn og med altaner ud mod sundet,
<?oxy_delete author="as" timestamp="20231113T090219+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T090219+0100"?>h<?oxy_insert_end?>vor Malmø og Landskrona ses i solskin
<?oxy_delete author="as" timestamp="20231113T090427+0100" content="O"?><?oxy_insert_start author="as" timestamp="20231113T090426+0100"?>o<?oxy_insert_end?>g Tycho Brahes ø og Gyldenlund.
I <?oxy_delete author="as" timestamp="20231113T090330+0100" content="K"?><?oxy_insert_start author="as" timestamp="20231113T090330+0100"?>k<?oxy_insert_end?>aravane <?oxy_delete author="as" timestamp="20231113T090333+0100" content="S"?><?oxy_insert_start author="as" timestamp="20231113T090332+0100"?>s<?oxy_insert_end?>kibe gå<?oxy_insert_start author="as" timestamp="20231113T090334+0100"?>r<?oxy_insert_end?> forbi,
<?oxy_delete author="as" timestamp="20231113T090337+0100" content="S"?><?oxy_insert_start author="as" timestamp="20231113T090337+0100"?>s<?oxy_insert_end?>lig <?oxy_delete author="as" timestamp="20231113T090339+0100" content="S"?><?oxy_insert_start author="as" timestamp="20231113T090338+0100"?>s<?oxy_insert_end?>vaneflok, så stor, kun ses i <?oxy_delete author="as" timestamp="20231113T090343+0100" content="S"?><?oxy_insert_start author="as" timestamp="20231113T090342+0100"?>s<?oxy_insert_end?>undet.



Når så i <?oxy_delete author="as" timestamp="20231113T090439+0100" content="A"?><?oxy_insert_start author="as" timestamp="20231113T090438+0100"?>a<?oxy_insert_end?>ft<?oxy_insert_start author="as" timestamp="20231113T090440+0100"?>e<?oxy_insert_end?>nen <?oxy_delete author="as" timestamp="20231113T090444+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T090444+0100"?>h<?oxy_insert_end?>imlens <?oxy_delete author="as" timestamp="20231113T090446+0100" content="S"?><?oxy_insert_start author="as" timestamp="20231113T090446+0100"?>s<?oxy_insert_end?>tjerner blinke<?oxy_insert_start author="as" timestamp="20231113T090448+0100"?>r<?oxy_insert_end?>,
<?oxy_delete author="as" timestamp="20231113T090453+0100" content="O"?><?oxy_insert_start author="as" timestamp="20231113T090452+0100"?>o<?oxy_insert_end?>g <?oxy_delete author="as" timestamp="20231113T090455+0100" content="F"?><?oxy_insert_start author="as" timestamp="20231113T090454+0100"?>f<?oxy_insert_end?>yret fra »Trekroner« lyser vidt om,
<?oxy_delete author="as" timestamp="20231113T090504+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T090504+0100"?>h<?oxy_insert_end?>vert <?oxy_delete author="as" timestamp="20231113T090507+0100" content="F"?><?oxy_insert_start author="as" timestamp="20231113T090507+0100"?>f<?oxy_insert_end?>artøj ude tænder sin <?oxy_delete author="as" timestamp="20231113T090511+0100" content="L"?><?oxy_insert_start author="as" timestamp="20231113T090510+0100"?>l<?oxy_insert_end?>anterne,
<?oxy_delete author="as" timestamp="20231113T090518+0100" content="T"?><?oxy_insert_start author="as" timestamp="20231113T090518+0100"?>t<?oxy_insert_end?>ro<?oxy_delete author="as" timestamp="20231113T090519+0100" content="e"?>r man at se et festbelyst Venedig,
<?oxy_delete author="as" timestamp="20231113T090525+0100" content="E"?><?oxy_insert_start author="as" timestamp="20231113T090524+0100"?>e<?oxy_insert_end?>n svømmende, illumineret <?oxy_delete author="as" timestamp="20231113T090528+0100" content="B"?><?oxy_insert_start author="as" timestamp="20231113T090528+0100"?>b<?oxy_insert_end?>y.
Dog skønnest er her inden fire <?oxy_delete author="as" timestamp="20231113T090533+0100" content="V"?><?oxy_insert_start author="as" timestamp="20231113T090533+0100"?>v<?oxy_insert_end?>ægge,
<?oxy_delete author="as" timestamp="20231113T090540+0100" content="I"?><?oxy_insert_start author="as" timestamp="20231113T090543+0100"?>i<?oxy_insert_end?> <?oxy_delete author="as" timestamp="20231113T090547+0100" content="Gje"?><?oxy_insert_start author="as" timestamp="20231113T090546+0100"?>gæ<?oxy_insert_end?>stfrihedens lykkelige <?oxy_delete author="as" timestamp="20231113T090551+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T090551+0100"?>h<?oxy_insert_end?>jem.



Johannes Ewald sang udødeligt
<?oxy_comment_start author="as" timestamp="20231113T090937+0100" comment="Jo egentlig en titel, men er stadig i tvivl om Lyksalighed skal med stort."?>Rungsteds Lyksalighed<?oxy_comment_end?>. O, havde han
<?oxy_delete author="as" timestamp="20231113T090606+0100" content="I"?><?oxy_insert_start author="as" timestamp="20231113T090605+0100"?>i<?oxy_insert_end?> vor <?oxy_delete author="as" timestamp="20231113T090608+0100" content="T"?><?oxy_insert_start author="as" timestamp="20231113T090608+0100"?>t<?oxy_insert_end?>id levet og i dette <?oxy_delete author="as" timestamp="20231113T090739+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T090739+0100"?>h<?oxy_insert_end?>jem,
<?oxy_delete author="as" timestamp="20231113T090752+0100" content="I"?><?oxy_insert_start author="as" timestamp="20231113T090751+0100"?>i<?oxy_insert_end?> dette <?oxy_delete author="as" timestamp="20231113T090734+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T090734+0100"?>h<?oxy_insert_end?>jertelag, hos disse <?oxy_delete author="as" timestamp="20231113T090732+0100" content="V"?><?oxy_insert_start author="as" timestamp="20231113T090732+0100"?>v<?oxy_insert_end?>enner,
<?oxy_delete author="as" timestamp="20231113T090748+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T090748+0100"?>h<?oxy_insert_end?>an havde sunget da en dejlig <?oxy_delete author="as" timestamp="20231113T090730+0100" content="S"?><?oxy_insert_start author="as" timestamp="20231113T090730+0100"?>s<?oxy_insert_end?>ang
<?oxy_delete author="as" timestamp="20231113T090745+0100" content="O"?><?oxy_insert_start author="as" timestamp="20231113T090743+0100"?>o<?oxy_insert_end?>m »Rolighed« og Rosenvængets <?oxy_delete author="as" timestamp="20231113T090727+0100" content="R"?><?oxy_insert_start author="as" timestamp="20231113T090727+0100"?>r<?oxy_insert_end?>oser.



Mit <?oxy_delete author="as" timestamp="20231113T091018+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T091017+0100"?>h<?oxy_insert_end?>jem i <?oxy_delete author="as" timestamp="20231113T091016+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T091015+0100"?>h<?oxy_insert_end?>jemmet, hvor bag <?oxy_delete author="as" timestamp="20231113T091032+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T091031+0100"?>h<?oxy_insert_end?>yldens <?oxy_delete author="as" timestamp="20231113T091035+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T091035+0100"?>h<?oxy_insert_end?>ang
<?oxy_delete author="as" timestamp="20231113T091038+0100" content="M"?><?oxy_insert_start author="as" timestamp="20231113T091037+0100"?>m<?oxy_insert_end?>it <?oxy_delete author="as" timestamp="20231113T091046+0100" content="L"?><?oxy_insert_start author="as" timestamp="20231113T091045+0100"?>l<?oxy_insert_end?>iv fik <?oxy_delete author="as" timestamp="20231113T091049+0100" content="S"?><?oxy_insert_start author="as" timestamp="20231113T091049+0100"?>s<?oxy_insert_end?>olskin<?oxy_insert_start author="as" timestamp="20231113T091256+0100"?>,<?oxy_insert_end?> og min <?oxy_delete author="as" timestamp="20231113T091053+0100" content="H"?><?oxy_insert_start author="as" timestamp="20231113T091052+0100"?>h<?oxy_insert_end?>arpe <?oxy_delete author="as" timestamp="20231113T091058+0100" content="K"?><?oxy_insert_start author="as" timestamp="20231113T091055+0100"?>k<?oxy_insert_end?>lang,
<?oxy_delete author="as" timestamp="20231113T091301+0100" content="D"?><?oxy_insert_start author="as" timestamp="20231113T091301+0100"?>d<?oxy_insert_end?>ig bringer jeg taknemlig, glad min <?oxy_delete author="as" timestamp="20231113T091325+0100" content="S"?><?oxy_insert_start author="as" timestamp="20231113T091324+0100"?>s<?oxy_insert_end?>ang!











<pb n="307"/></div>
