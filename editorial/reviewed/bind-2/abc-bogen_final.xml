<row role="data" rows="1" cols="1"><cell type="position" role="data" rows="1" cols="1">194,7</cell><cell type="deviation" role="data" rows="1" cols="1">due!« &lt; due!</cell></row>
<row role="data" rows="1" cols="1"><cell type="position" role="data" rows="1" cols="1">196,29</cell><cell type="deviation" role="data" rows="1" cols="1">bedre!« &lt; bedre!</cell></row>
</table>

<table rend="textcomments">
<cell type="page" role="data" rows="1" cols="1">193</cell><row xml:id="txtcmnt-193-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">den gamle Abc</cell><cell type="data-definition" role="data" rows="1" cols="1">J.R. Thieles ABC udkom første gang i 1770 og var i brug op i 1840’erne.</cell></row><row xml:id="txtcmnt-193-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">mægtede</cell><cell type="data-definition" role="data" rows="1" cols="1">magtede.</cell></row><row xml:id="txtcmnt-193-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Hanen</cell><cell type="data-definition" role="data" rows="1" cols="1">symbol på årvågenhed og opmærksomhed; et lån fra de tyske ABC’er og en fast illustration i de danske.</cell></row><row xml:id="txtcmnt-193-04" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">fremad</cell><cell type="data-definition" role="data" rows="1" cols="1">moderne.</cell></row>
<cell type="page" role="data" rows="1" cols="1">194</cell><row xml:id="txtcmnt-194-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Xanthus</cell><cell type="data-definition" role="data" rows="1" cols="1">eksempelordet til bogstavet X i den gamle ABC, der lød således: »Xanthus var en af de Heste, / Som Neptunus så tilbedste«. Xanthos optræder i Iliaden som Achilleus’ hest.</cell></row><row xml:id="txtcmnt-194-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">En Bonde  … med!</cell><cell type="data-definition" role="data" rows="1" cols="1">hentydning til forskellen mellem bondens usle stilling under stavnsbåndet (1733-1788) og samtidens politisk engagerede og organiserede bønder omkring Bondevennernes Selskab, stiftet 1846.</cell></row><row xml:id="txtcmnt-194-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Columbus</cell><cell type="data-definition" role="data" rows="1" cols="1">Christoffer Columbus (1451-1506), opdagede Amerika i 1492.</cell></row><row xml:id="txtcmnt-194-04" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Galt(en)</cell><cell type="data-definition" role="data" rows="1" cols="1">kastreret orne.</cell></row>
<cell type="page" role="data" rows="1" cols="1">195</cell><row xml:id="txtcmnt-195-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">J</cell><cell type="data-definition" role="data" rows="1" cols="1">i frakturskrift (gotisk skrift, som man brugte på H.C. Andersens tid) er bogstavet I identisk med J.</cell></row><row xml:id="txtcmnt-195-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Lorgnet</cell><cell type="data-definition" role="data" rows="1" cols="1">briller uden stænger, som klemmes fast på næseroden.</cell></row><row xml:id="txtcmnt-195-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Nummer-Parquet</cell><cell type="data-definition" role="data" rows="1" cols="1">parket med nummererede pladser i modsætning til parterret, der i Det Kgl. Teater havde unummererede pladser.</cell></row><row xml:id="txtcmnt-195-04" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Duens Olieblad</cell><cell type="data-definition" role="data" rows="1" cols="1">blad fra oliventræet; hentydning til beretningen om syndfloden i 1. Mosebog 8,10 f.</cell></row>
<pb n="486"/>
<cell type="page" role="data" rows="1" cols="1">196</cell><row xml:id="txtcmnt-196-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">højvelbår’n</cell><cell type="data-definition" role="data" rows="1" cols="1">fast tiltaleform for personer i 2. rangklasse. Hentydning til replik i H.C. Andersens eventyrkomedie Mer end Perler og Guld, 1849 (BFN 553), hvor der til selskab i abekattenes land kommer en frue med barn og amme: »Min Amme, ret et Rundetårn, / Med samt min lille Højvelbårn!«</cell></row><row xml:id="txtcmnt-196-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">mange Svin på Skoven.</cell><cell type="data-definition" role="data" rows="1" cols="1">i jordfællesskabets tid lod bønderne svinene gå frit i skovene for at æde olden. Her i overført betydning: være velhavende.</cell></row><row xml:id="txtcmnt-196-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Thekedlen … Themaskinen(s)</cell><cell type="data-definition" role="data" rows="1" cols="1">henholdsvis den jævne mands og borgerskabets.</cell></row><row xml:id="txtcmnt-196-04" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Socrates … Xanthippe</cell><cell type="data-definition" role="data" rows="1" cols="1">den græske filosof Sokrates (469-399 f.Kr.) var gift med Xanthippe, der havde ry for at være stridbar.</cell></row><row xml:id="txtcmnt-196-05" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Ygdrasil</cell><cell type="data-definition" role="data" rows="1" cols="1">er i den nordiske mytologi et asketræ, hvis top er i himlen, mens dets tre rødder er henholdsvis hos menneskene, jætterne og i Hel (egentlig det skjulte, navn for både det underjordiske dødsrige og dets herskerinde, datter af Loke og jættekvinden Angerboda). Yggdrasil var billedet på verdenslivets uforgængelighed trods ødelæggende kræfter: Dets rod gnaves af slangen Nidhugg, men nornerne, skæbnegudinderne, vander det, så det altid er grønt.</cell></row>
<cell type="page" role="data" rows="1" cols="1">197</cell><row xml:id="txtcmnt-197-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">gyldent</cell><cell type="data-definition" role="data" rows="1" cols="1">måske hentydning til Apulejus’ (ca.125-ca. 180) satiriske skælmeroman Metamorfoser, også kaldet Det gyldne Æsel.</cell></row>
</table></div>
                                   
