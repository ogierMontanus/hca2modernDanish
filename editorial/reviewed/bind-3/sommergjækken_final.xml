<cell type="page" role="data" rows="1" cols="1">130</cell><row xml:id="txtcmnt-130-01" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">skjør</cell><cell type="data-definition" role="data" rows="1" cols="1">skrøbelig.</cell></row><row xml:id="txtcmnt-130-02" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">min Sommergæk</cell><cell type="data-definition" role="data" rows="1" cols="1">person, der gækkes, dvs. overraskes ved at modtage årets første blomst samt et gækkebrev og derved bliver ens nar for sommeren.</cell></row><row xml:id="txtcmnt-130-03" role="data" rows="1" cols="1"><cell type="data-term" role="data" rows="1" cols="1">Vinternar</cell><cell type="data-definition" role="data" rows="1" cols="1">person, der er ens nar for vinteren, fordi vedkommende er gækket ved et gækkebrev.</cell></row>
